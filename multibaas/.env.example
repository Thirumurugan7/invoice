# console.curvegrid.com -> your deployment (network: Ethereum Sepolia, or a custom network for local testing)
MB_BASE_URL=https://YOUR_DEPLOYMENT_ID.multibaas.com
MB_API_KEY=YOUR_ADMIN_API_KEY
CHAIN_ID=11155111
# Operator key used when no Cloud Wallet is configured (MultiBaas builds + submits, you sign locally).
# Testnet only; never commit.
OPERATOR_PK=0x...
# OPTIONAL Cloud Wallet (HSM) address registered in MultiBaas; must hold OPERATOR_ROLE on InvoiceRegistry
# (deploy with OPERATOR=<this address>). Used by operator.ts with signAndSubmit.
MB_HSM_ADDRESS=0x...
# Webhook receiver
WEBHOOK_PORT=8787
WEBHOOK_SECRET=secret-shown-when-you-create-the-webhook-in-MultiBaas
WEBHOOK_URL=https://your-public-tunnel.example/webhook
